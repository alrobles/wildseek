# WildSeek env template — copy to .env (never commit live keys).
# The demo (serve/) runs keyless on baked artifacts; keys enable
# live agent calls (nightly factory, litmine, release gate).

# Meta Model API (orchestration, triage, briefing, extraction)
MODEL_API_KEY=

# Open-weight inference partners (bulk triage/extraction, judge)
FIREWORKS_API_KEY=
BASETEN_API_KEY=

# Nightly factory
WILDSEEK_CASA=1
WILDSEEK_DEPLOY=serve-host:/data-dir/
WILDSEEK_BEEG=
QA_COST_CAP_USD=5.0
